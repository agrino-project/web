.mx_CompleteSecurityBody {
    color: $authpage-primary-color;
    background-color: $background;
    border-radius: 4px;
    padding: 20px 20px 60px 20px;
    box-sizing: border-box;
    max-width: 100%;

    h2 {
        font-size: $font-24px;
        font-weight: var(--cpd-font-weight-semibold);
        margin-top: 0;
    }

    h3 {
        font: var(--cpd-font-body-md-semibold);
    }

    a:link,
    a:hover,
    a:visited {
        color: $accent;
        text-decoration: none;
    }

    /* Tighten everything on phones so buttons and titles don't push past the card edge. */
    @media (max-width: 768px) {
        padding: 16px 12px 16px 12px;
        width: 100%;

        h2 {
            font-size: 18px;
            line-height: 1.4;
        }

        /* Buttons inside the body (verify on other device / can't verify) must
           shrink down to the card width on narrow screens. */
        .mx_AccessibleButton {
            box-sizing: border-box;
            white-space: normal;
        }
    }
}
