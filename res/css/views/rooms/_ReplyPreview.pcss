.mx_ReplyPreview {
    border: none;
    background: #f4f6f9;
    max-height: 50vh;
    overflow: auto;
    border-radius: 12px 12px 0 0;

    .mx_ReplyPreview_section {
        border-bottom: none;
        display: flex;
        flex-flow: column;
        row-gap: $spacing-8;
        padding: 12px 16px;

        .mx_ReplyPreview_header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            column-gap: 8px;

            .mx_ReplyPreview_header_titleContainer {
                display: flex;
                align-items: center;
                column-gap: 8px;
            }

            .mx_ReplyPreview_header_icon {
                display: inline-block;
                background-color: #16502b;
                mask-image: url("@vector-im/compound-design-tokens/icons/reply.svg"); /* مسیر آیکون ریپلای سیستمتان */
                mask-repeat: no-repeat;
                mask-position: center;
                mask-size: contain;
                width: 18px;
                height: 18px;
            }

            .mx_ReplyPreview_header_title {
                color: #16502b;
                font-weight: 700;
                font-size: 14px;
            }

            .mx_ReplyPreview_header_cancel {
                background-color: #cccccc;
                mask-image: url("@vector-im/compound-design-tokens/icons/close.svg");
                mask-repeat: no-repeat;
                mask-position: center;
                mask-size: contain;
                width: 16px;
                height: 16px;
                cursor: pointer;
                opacity: 0.6;
                transition: opacity 0.2s;

                &:hover {
                    opacity: 1;
                }
            }
        }
    }
}

.mx_RoomView_body {
    .mx_ReplyPreview {
        box-shadow: 0px -8px 24px rgba(0, 0, 0, 0.05);
        border-radius: 16px 16px 0 0;
        margin-inline: -12px;
    }
}
