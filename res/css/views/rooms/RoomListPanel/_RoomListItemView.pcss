/**
 * The RoomListItemView has the following structure:
 * button--------------------------------------------------|
 * | <-12px-> container------------------------------------|
 * |          | room avatar <-8px-> content----------------|
 * |          |                      | room_name <- 20px ->|
 * |          |                      | --------------------| <-- border
 * |-------------------------------------------------------|
 */
.mx_RoomListItemView {
    /* Remove button default style */
    background: unset;
    border: none;
    padding: 0;
    text-align: unset;
    cursor: pointer;
    height: 60px;
    padding: 0 12px;
    width: 100%;
    font: var(--cpd-font-body-md-regular);

    .mx_RoomListItemView_content {
        height: 100%;
        flex: 1;
        /* The border is only under the room name and the future hover menu  */
        border-bottom: var(--cpd-border-width-0-5) solid var(--cpd-color-bg-subtle-secondary);
        box-sizing: border-box;
        min-width: 0;
        padding: 8px 0;

        .mx_RoomListItemView_messagePreview {
            font: var(--cpd-font-body-sm-regular);
            color: var(--cpd-color-text-secondary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    }
}

.mx_RoomListItemView_hover {
    background-color: var(--agrino-hover-bg);
}

.mx_RoomListItemView_selected {
    background-color: var(--agrino-selected-bg) !important;
}

.mx_RoomListItemView_bold .mx_RoomListItemView_roomName {
    font: var(--cpd-font-body-md-semibold);
}

.mx_RoomListItemView_meta {
    flex: 1;
    min-width: 0;
    gap: 2px;
}

.mx_RoomListItemView_roomName {
    font-size: 14px;
    font-weight: 600;
    color: var(--cpd-color-text-primary);

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_RoomListItemView_messagePreview {
    font-size: 12px;
    color: var(--cpd-color-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 180px;
}

.mx_RoomListItemView_time {
    font-size: 11px;
    color: var(--cpd-color-text-secondary);
    flex-shrink: 0;
}

.mx_RoomListItemView_badge {
    padding: 3px 5px;
    color: white;
    background: #2f6b3f;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.mx_RoomListItemView_roomWrap {
    width: 100%;
}
