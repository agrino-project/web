.mx_RoomListPrimaryFilters {
    display: flex;
    gap: var(--cpd-space-2x);
    overflow-x: auto;
    overflow-y: hidden;
    padding-inline: var(--cpd-space-2x);
    padding-bottom: 10px;
    scroll-behavior: smooth;
    scroll-padding-inline: var(--cpd-space-3x);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    &::-webkit-scrollbar {
        display: none;
    }
}

.mx_RoomListPrimaryFilters_button {
    flex-shrink: 0;
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    background: var(--cpd-color-bg-subtle-secondary);
    border: none;
    border-radius: 16px;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-primary);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease;

    &:hover {
        background: var(--cpd-color-bg-subtle-primary);
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }
}

.mx_RoomListPrimaryFilters_button_active {
    background: #2f6b3f;
    color: var(--cpd-color-text-on-solid-primary);
    font: var(--cpd-font-body-sm-semibold);

    &:hover {
        background: #3d6a4a;
    }
}

.mx_RoomListPrimaryFilters_wrapper {
    position: relative;
}

.mx_RoomListPrimaryFilters {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    &::-webkit-scrollbar {
        display: none;
    }
}

.mx_RoomListPrimaryFilters_arrow {
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    width: 23px;
    height: 23px;
    border: none;
    border-radius: 50%;
    background: #326430;
    color: white;
    z-index: 10;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
}

.mx_RoomListPrimaryFilters_arrow:hover {
    opacity: 0.9;
}

.mx_RoomListPrimaryFilters_arrowStart {
    inset-inline-start: 4px;
}

.mx_RoomListPrimaryFilters_arrowEnd {
    inset-inline-end: 4px;
}
