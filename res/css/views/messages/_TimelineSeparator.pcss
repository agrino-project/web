.mx_TimelineSeparator {
    clear: both;
    margin: 12px 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_DateSeparator_dateContent {
    padding: 5px 12px;
    border: 1px solid #daddda;
    border-radius: 18px;
    color: #404540;
    background: #f9faf9;
}
