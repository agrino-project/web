.mx_CardToCardCard {
    width: 100%;
    height: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    position: relative;
    z-index: 1;
    overflow-y: auto;
    box-sizing: border-box;

    .mx_CardToCardCard_container {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .mx_CardToCardCard_header {
        background: linear-gradient(135deg, #326430 0%, #2a5428 100%);
        color: white;
        padding: 32px 24px;
        text-align: center;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;

        .mx_CardToCardCard_headerContent {
            flex: 1;
        }

        h1 {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 6px;
            margin-top: 0;
        }

        p {
            opacity: 0.95;
            font-size: 15px;
            margin: 0;
        }
    }

    .mx_CardToCardCard_formBody {
        padding: 40px 48px;
    }

    .mx_CardToCardCard_inputGroup {
        margin-bottom: 24px;

        label {
            display: block;
            margin-bottom: 9px;
            font-weight: 600;
            font-size: 15px;
            color: #1e293b;
        }
    }

    .mx_CardToCardCard_cardInputs {
        display: flex;
        gap: 16px;
        direction: ltr;

        input {
            width: 100%;
            padding: 14px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 18px;
            text-align: center;
            font-weight: 600;
            background: white;
            transition: all 0.25s;

            &:focus {
                outline: none;
                border-color: #326430;
                box-shadow: 0 0 0 3px rgba(50, 100, 48, 0.1);
            }
        }
    }

    .mx_CardToCardCard_amountWrapper {
        position: relative;

        .mx_CardToCardCard_tomanLabel {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            font-weight: 600;
            color: #475569;
            pointer-events: none;
        }

        #amount {
            padding-left: 80px !important;
            text-align: right;
            direction: rtl;
            font-size: 19px;
            font-weight: 600;
        }
    }

    input[type="text"] {
        width: 100%;
        padding: 14px 18px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 15px;
        background: white;
        transition: all 0.25s;

        &:focus {
            outline: none;
            border-color: #326430;
            box-shadow: 0 0 0 3px rgba(50, 100, 48, 0.1);
        }
    }

    .mx_CardToCardCard_row {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;

        .mx_CardToCardCard_inputGroup {
            flex: 1;
            margin-bottom: 0;
        }
    }

    .mx_CardToCardCard_otpGroup {
        position: relative;

        #otpInput {
            padding-left: 150px !important;
            letter-spacing: 10px;
            font-size: 22px;
            font-weight: bold;
        }

        .mx_CardToCardCard_getOtpBtn {
            position: absolute;
            left: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: #326430;
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;

            &:disabled {
                background: #cbd5e1;
                color: #64748b;
                cursor: not-allowed;
            }
        }
    }

    .mx_CardToCardCard_timer {
        margin-top: 8px;
        font-size: 13px;
        color: #64748b;
    }

    .mx_CardToCardCard_btnPrimary {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #326430 0%, #2a5428 100%);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 24px;
        transition: all 0.2s;

        &:hover:not(:disabled) {
            background: linear-gradient(135deg, #2a5428 0%, #326430 100%);
            box-shadow: 0 4px 12px rgba(50, 100, 48, 0.3);
        }

        &:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
    }
}

.mx_CardToCardCard_progressDialog {
    .mx_CardToCardCard_progressContent {
        padding: 20px;
        text-align: center;
        min-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 20px;

        .mx_CardToCardCard_progressInfo {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
    }
}

/* ---- Payment report dialog (success / failed / unknown) ---- */
.mx_CardToCardCard_reportDialog {
    padding: 0;
    border-radius: 16px;
    overflow: hidden;

    /* Hide the default (empty) dialog title bar so our green header sits flush */
    .mx_Dialog_title,
    .mx_Dialog_header {
        display: none;
    }

    .mx_CardToCardReport {
        width: 100%;
    }

    .mx_CardToCardReport_header {
        background: linear-gradient(135deg, #326430 0%, #2a5428 100%);
        color: white;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 16px;

        h1 {
            font-size: 18px;
            font-weight: 600;
            margin: 0;
            flex: 1;
            text-align: center;
        }
    }

    .mx_CardToCardReport_body {
        padding: 16px 18px 20px;
    }

    .mx_CardToCardReport_status {
        border-radius: 14px;
        padding: 22px 16px;
        text-align: center;
        margin-bottom: 18px;

        .mx_CardToCardReport_statusIcon {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 10px;
            animation: mx_CardToCardReport_pop 0.45s ease-out;
        }

        .mx_CardToCardReport_iconCircle {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            color: white;
            font-size: 30px;
            font-weight: 800;
            line-height: 1;
        }

        .mx_CardToCardReport_statusText {
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .mx_CardToCardReport_statusSub {
            font-size: 13px;
            color: #475569;
        }
    }

    .mx_CardToCardReport_rows {
        .mx_CardToCardReport_row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 13px 4px;
            border-bottom: 1px solid #eef1f4;

            &:last-child {
                border-bottom: none;
            }
        }

        .mx_CardToCardReport_rowLabel {
            color: #64748b;
            font-size: 14px;
        }

        .mx_CardToCardReport_rowValue {
            color: #1e293b;
            font-size: 14px;
            font-weight: 700;
            direction: ltr;
            unicode-bidi: plaintext;

            &.mx_CardToCardReport_cardValue {
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }
        }
    }

    .mx_CardToCardReport_addContact {
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        margin-top: 16px;
        font-size: 13px;
        color: #475569;
        cursor: pointer;

        input {
            width: 18px;
            height: 18px;
            accent-color: #326430;
            cursor: pointer;
        }
    }

    .mx_CardToCardReport_note {
        margin-top: 16px;
        font-size: 13px;
        line-height: 1.7;
        color: #64748b;
        text-align: center;
    }

    .mx_CardToCardReport_shareBtn {
        margin-top: 18px;
        background: linear-gradient(135deg, #326430 0%, #2a5428 100%);
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        width: 100% !important;
        color: white !important;
        display: flex !important;
        gap: 4px !important;
        padding-block: 10px !important;

        &:hover {
            box-shadow: 0 4px 12px rgba(50, 100, 48, 0.3);
        }
    }

    /* Status colour variants */
    .mx_CardToCardReport_success {
        .mx_CardToCardReport_status {
            background: #e9f5ea;
        }

        .mx_CardToCardReport_statusText {
            color: #2e7d32;
        }

        .mx_CardToCardReport_statusIcon svg {
            color: #2e9e44;
        }
    }

    .mx_CardToCardReport_failed {
        .mx_CardToCardReport_status {
            background: #fdecec;
        }

        .mx_CardToCardReport_statusText {
            color: #d32f2f;
        }

        .mx_CardToCardReport_iconCircle {
            background: linear-gradient(135deg, #ef4444 0%, #c62828 100%);
        }
    }

    .mx_CardToCardReport_unknown {
        .mx_CardToCardReport_status {
            background: #fdf6e3;
        }

        .mx_CardToCardReport_statusText {
            color: #e09b00;
        }

        .mx_CardToCardReport_iconCircle {
            background: linear-gradient(135deg, #f5b301 0%, #e08e00 100%);
        }
    }
}

@keyframes mx_CardToCardReport_pop {
    0% {
        transform: scale(0);
        opacity: 0;
    }
    60% {
        transform: scale(1.15);
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

/* Mobile: full-screen page instead of dialog card */
@media only screen and (max-width: 768px) {
    .mx_CardToCardCard {
        padding: 0;
        height: 100% !important;
        max-width: none;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;

        .mx_CardToCardCard_container {
            max-width: none;
            border-radius: 0;
            box-shadow: none;
            min-height: 100%;
        }

        .mx_CardToCardCard_header {
            border-radius: 0;
            padding: 24px 16px;
        }

        .mx_CardToCardCard_formBody {
            padding: 24px 16px;
        }
    }
}

.mx_Dialog_primary {
    background: linear-gradient(135deg, #326430 0%, #2a5428 100%);
    border: none;
    border-radius: 12px;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: bold;
    width: 100%;
    margin-top: 20px;
    color: white;
    transition: transform 0.2s;

    &:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(50, 100, 48, 0.3);
    }
}
