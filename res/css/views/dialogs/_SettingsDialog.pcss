/* Not actually a component but things shared by settings components */
.mx_UserSettingsDialog,
.mx_RoomSettingsDialog,
.mx_SpaceSettingsDialog,
.mx_SpacePreferencesDialog {
    width: 90vw;
    max-width: 980px;
    /* set the height too since tabbed view scrolls itself. */
    height: 80vh;

    .mx_TabbedView {
        top: 90px;
    }

    .mx_TabbedView .mx_SettingsTab {
        box-sizing: border-box;
        min-width: 580px;
        padding-right: 100px;
        display: flex;
        flex-direction: column;

        /* Put some padding on the bottom to avoid the settings tab from */
        /* colliding harshly with the dialog when scrolled down. */
        padding-bottom: 100px;
    }

    .mx_SettingsDialog_tabLabelsAlert::after {
        display: inline-block;
        content: "";
        width: 8px;
        height: 8px;
        background-color: var(--cpd-color-icon-critical-primary);
        clip-path: circle(4px);
        position: absolute;
        right: var(--cpd-space-4x);
    }
}

/* Mobile: keep the glass-card look (border, radius, padding) but stop the
   inner SettingsTab from being wider than the dialog (its `min-width: 580px`
   + `padding-right: 100px` cause horizontal scroll on phones), and let
   inputs / copyable text actually breathe instead of being shoved off-screen. */
@media (max-width: 768px) {
    .mx_UserSettingsDialog,
    .mx_RoomSettingsDialog,
    .mx_SpaceSettingsDialog,
    .mx_SpacePreferencesDialog {
        .mx_TabbedView .mx_SettingsTab {
            min-width: 0;
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 48px;
            overflow-x: hidden;
        }

        .mx_SettingsSection,
        .mx_SettingsSubsection,
        .mx_UserProfileSettings,
        .mx_UserProfileSettings_profile {
            min-width: 0;
            max-width: 100%;
            box-sizing: border-box;
        }

        .mx_UserProfileSettings_profile_displayName input,
        .mx_UserProfileSettings .mx_CopyableText input,
        .mx_UserProfileSettings .mx_CopyableText {
            min-width: 0;
            max-width: 100%;
            box-sizing: border-box;
        }
    }
}

/* On narrow viewports, the tab labels are hidden, so we need to shift the indicator so it isn't over the tab icon. */
@media (max-width: 1024px) {
    .mx_UserSettingsDialog,
    .mx_RoomSettingsDialog,
    .mx_SpaceSettingsDialog,
    .mx_SpacePreferencesDialog {
        .mx_SettingsDialog_tabLabelsAlert::after {
            right: var(--cpd-space-1x);
            top: var(--cpd-space-1x);
        }
    }
}
