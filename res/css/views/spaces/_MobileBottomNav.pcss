.mx_MobileBottomNav {
    display: none;
}

@media only screen and (max-width: 768px) {
    .mx_MobileBottomNav {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-around;
        width: 100%;
        height: 56px;
        background-color: $background;
        border-top: 1px solid $separator;
        padding: 4px 0;
        flex-shrink: 0;
        z-index: 10;
    }

    .mx_MobileBottomNav_tab {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        flex: 1;
        border: none;
        background: none;
        cursor: pointer;
        padding: 4px 0;
        color: $secondary-content;
        -webkit-tap-highlight-color: transparent;

        &.active {
            color: $accent;

            .mx_MobileBottomNav_icon {
                background-color: $accent;
            }
        }

        &:hover:not(.active) {
            color: $primary-content;

            .mx_MobileBottomNav_icon {
                background-color: $primary-content;
            }
        }
    }

    .mx_MobileBottomNav_icon {
        width: 20px;
        height: 20px;
        mask-position: center;
        mask-repeat: no-repeat;
        mask-size: 20px;
        background-color: $secondary-content;
    }

    .mx_MobileBottomNav_icon_chat {
        mask-image: url("@vector-im/compound-design-tokens/icons/chat-solid.svg");
    }

    .mx_MobileBottomNav_icon_agriculture {
        mask-image: url("$(res)/img/element-icons/agriculture.svg");
    }

    .mx_MobileBottomNav_icon_services {
        mask-image: url("$(res)/img/element-icons/services.svg");
    }

    .mx_MobileBottomNav_icon_more {
        mask-image: url("@vector-im/compound-design-tokens/icons/overflow-horizontal.svg");
    }

    .mx_MobileBottomNav_label {
        font-size: 10px;
        line-height: 14px;
        font-weight: 500;
        white-space: nowrap;
    }

    /* More menu wrapper */
    .mx_MobileBottomNav_moreWrapper {
        position: relative;
        flex: 1;
        display: flex;
        justify-content: center;
    }

    /* Popup menu above the More button */
    .mx_MobileBottomNav_moreMenu {
        position: absolute;
        bottom: 100%;
        margin-bottom: 8px;
        background-color: $background;
        border: 1px solid $separator;
        border-radius: 12px;
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
        max-height: 70vh;
        overflow-y: auto;
        padding: 8px 0;
        z-index: 100;
        width: 220px;
        left: 85%;
        transform: translateX(-50%);
    }

    .mx_MobileBottomNav_menuProfile {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
    }

    .mx_MobileBottomNav_menuProfileInfo {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .mx_MobileBottomNav_menuProfileName {
        font-size: 14px;
        font-weight: 600;
        color: $primary-content;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_MobileBottomNav_menuProfileId {
        font-size: 12px;
        color: $secondary-content;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_MobileBottomNav_menuDivider {
        height: 1px;
        background-color: $separator;
        margin: 4px 0;
    }

    .mx_MobileBottomNav_menuItem {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 12px 16px;
        border: none;
        background: none;
        cursor: pointer;
        font-size: 14px;
        color: $primary-content;
        text-align: start;
        -webkit-tap-highlight-color: transparent;

        &:hover {
            background-color: $panel-actions;
        }

        &.mx_MobileBottomNav_menuItem--danger {
            color: $alert;

            .mx_MobileBottomNav_menuIcon {
                background-color: $alert;
            }
        }
    }

    .mx_MobileBottomNav_menuIcon {
        width: 20px;
        height: 20px;
        mask-position: center;
        mask-repeat: no-repeat;
        mask-size: 20px;
        background-color: $secondary-content;
        flex-shrink: 0;
    }

    .mx_MobileBottomNav_menuIcon_home {
        mask-image: url("@vector-im/compound-design-tokens/icons/home-solid.svg");
    }

    .mx_MobileBottomNav_menuIcon_settings {
        mask-image: url("@vector-im/compound-design-tokens/icons/settings-solid.svg");
    }

    .mx_MobileBottomNav_menuIcon_notifications {
        mask-image: url("@vector-im/compound-design-tokens/icons/notifications-solid.svg");
    }

    .mx_MobileBottomNav_menuIcon_security {
        mask-image: url("@vector-im/compound-design-tokens/icons/lock-solid.svg");
    }

    .mx_MobileBottomNav_menuIcon_signout {
        mask-image: url("@vector-im/compound-design-tokens/icons/leave.svg");
    }
}
