.mx_BazaarPage {
    --bz-bg: var(--agrino-bg);
    --bz-panel: var(--agrino-surface);
    --bz-line: var(--agrino-surface-border);
    --bz-text: var(--cpd-color-text-primary);
    --bz-muted: var(--cpd-color-text-secondary);
    --bz-green: var(--cpd-color-bg-action-primary-rest);
    --bz-green2: #43a047;
    --bz-blue: #2563eb;
    --bz-red: var(--cpd-color-text-critical-primary);
    --bz-orange: #f59e0b;
    --bz-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    --bz-radius: 18px;
    --bz-hover-surface: var(--agrino-hover-bg);
    --bz-selected-surface: var(--agrino-selected-bg);
    --bz-subtle-bg: var(--agrino-surface-muted);
    --bz-input-bg: var(--cpd-color-form-bg);
    --bz-input-border: var(--cpd-color-form-border);
    --bz-secondary-btn-bg: var(--agrino-surface-muted);
    --bz-secondary-btn-text: var(--cpd-color-text-primary);

    display: flex;
    gap: 16px;
    padding: 16px;
    min-height: 100%;
    width: 100%;
    box-sizing: border-box;
    background: var(--bz-bg);
    color: var(--bz-text);
    overflow-y: auto;
    font-family: inherit;
    overflow-x: hidden;
}

.mx_BazaarPage_sidebar {
    width: 320px;
    flex-shrink: 0;
    background: var(--bz-panel);
    border: 1px solid var(--bz-line);
    border-radius: var(--bz-radius);
    box-shadow: var(--bz-shadow);
    overflow: hidden;
    align-self: flex-start;
    position: sticky;
    top: 0px;
    max-height: calc(100vh - 32px);
    display: flex;
    flex-direction: column;
}

.mx_BazaarPage_sidebarHeader {
    padding: 16px;
    background: linear-gradient(135deg, var(--bz-green), var(--bz-green2));
    color: var(--cpd-color-text-on-solid-primary);

    h1 {
        margin: 0;
        font-size: 20px;
    }

    p {
        margin: 8px 0 0;
        font-size: 13px;
        opacity: 0.9;
    }
}

.mx_BazaarPage_menu {
    overflow: auto;
    flex: 1;
}

.mx_BazaarPage_menuItem {
    border-bottom: 1px solid var(--bz-line);
}

.mx_BazaarPage_menuMain {
    width: 100%;
    border: none;
    background: var(--bz-panel);
    padding: 14px 16px;
    text-align: inherit;
    font-size: 15px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--bz-text);
    transition: background 0.2s;

    &:hover {
        background: var(--bz-hover-surface);
    }

    &.active {
        background: var(--bz-selected-surface);
        color: var(--bz-text);
        font-weight: 600;
    }
}

.mx_BazaarPage_chevron {
    transition: transform 0.2s;
}

.mx_BazaarPage_menuItem.open .mx_BazaarPage_chevron {
    transform: rotate(180deg);
}

.mx_BazaarPage_submenu {
    padding: 8px 12px 12px;
    background: var(--bz-subtle-bg);

    button {
        width: 100%;
        border: 1px solid var(--bz-line);
        background: var(--bz-panel);
        color: var(--bz-text);
        border-radius: 12px;
        padding: 10px 12px;
        margin: 6px 0;
        text-align: inherit;
        cursor: pointer;
        transition: 0.2s;
        font-size: 14px;

        &:hover {
            border-color: var(--bz-green);
            background: var(--bz-selected-surface);
        }

        &.selected {
            border-color: var(--bz-green2);
            background: var(--bz-selected-surface);
            color: var(--bz-text);
            font-weight: 600;
        }
    }
}

.mx_BazaarPage_content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.mx_BazaarPage_topbar {
    background: var(--bz-panel);
    border: 1px solid var(--bz-line);
    border-radius: var(--bz-radius);
    box-shadow: var(--bz-shadow);
    padding: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.mx_BazaarPage_selectedInfo {
    display: flex;
    flex-direction: column;
    gap: 4px;

    h2 {
        margin: 0;
        font-size: 18px;
        color: var(--bz-text);
    }

    span {
        color: var(--bz-muted);
        font-size: 14px;
    }
}

.mx_BazaarPage_actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.mx_BazaarPage_btn {
    border: none;
    padding: 11px 18px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
    transition: 0.2s;
    color: var(--cpd-color-text-on-solid-primary);

    &:hover {
        transform: translateY(-1px);
        opacity: 0.95;
    }

    &.mx_BazaarPage_btn--buy {
        background: var(--bz-blue);
    }

    &.mx_BazaarPage_btn--sell {
        background: var(--bz-green);
    }

    &.mx_BazaarPage_btn--secondary {
        background: var(--bz-secondary-btn-bg);
        color: var(--bz-secondary-btn-text);
        border: 1px solid var(--bz-line);
    }

    &.mx_BazaarPage_btn--danger {
        background: var(--bz-red);
    }

    &.mx_BazaarPage_btn--warning {
        background: var(--bz-orange);
        color: var(--cpd-color-text-on-solid-primary);
    }
}

.mx_BazaarPage_panel {
    background: var(--bz-panel);
    border: 1px solid var(--bz-line);
    border-radius: var(--bz-radius);
    box-shadow: var(--bz-shadow);
    padding: 18px;

    h3 {
        margin: 0 0 12px;
        font-size: 18px;
        color: var(--bz-text);
    }

    h4 {
        margin: 0 0 8px;
        font-size: 16px;
        color: var(--bz-text);
    }
}

.mx_BazaarPage_grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.mx_BazaarPage_field {
    display: flex;
    flex-direction: column;
    gap: 6px;

    label {
        font-size: 13px;
        color: var(--bz-muted);
    }

    input,
    select,
    textarea {
        width: 100%;
        border: 1px solid var(--bz-input-border);
        border-radius: 12px;
        padding: 11px 12px;
        font-size: 14px;
        background: var(--bz-input-bg);
        outline: none;
        font-family: inherit;
        color: var(--bz-text);
        box-sizing: border-box;
    }

    textarea {
        min-height: 90px;
        resize: vertical;
    }
}

/* Element's global reset in _common.pcss uses a 3×:not() + descendant selector
   which resolves to specificity 0,0,4,1 — higher than any reasonable chain of
   our own classes. Use !important on the properties it steals (background,
   padding, font) rather than escalating specificity further. */
.mx_BazaarPage_field input[type="text"],
.mx_BazaarPage_field input[type="password"],
.mx_BazaarPage_field input[type="search"] {
    background: var(--bz-input-bg) !important;
    color: var(--bz-text) !important;
    padding: 11px 12px !important;
    font: inherit !important;
    font-size: 14px !important;
    font-weight: normal !important;
    border: 1px solid var(--bz-input-border) !important;
    border-radius: 12px !important;
    width: 100% !important;
    box-sizing: border-box !important;
}

.mx_BazaarPage_checkboxGroup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px 0;
}

.mx_BazaarPage_checkboxItem {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--bz-text);
    cursor: pointer;

    input {
        width: auto;
        margin: 0;
    }
}

.mx_BazaarPage_sectionActions {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
}

.mx_BazaarPage_filters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 14px;
    align-items: end;
}

.mx_BazaarPage_filterButtons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-self: end;
}

.mx_BazaarPage_cardList {
    display: grid;
    gap: 12px;
}

.mx_BazaarPage_adCard {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    align-items: center;
    border: 1px solid var(--bz-line);
    border-radius: 16px;
    padding: 12px;
    background: var(--bz-panel);
}

.mx_BazaarPage_adMeta {
    h4 {
        margin: 0 0 6px;
        font-size: 16px;
        color: var(--bz-text);
    }

    p {
        margin: 0;
        color: var(--bz-muted);
        font-size: 13px;
        line-height: 1.7;
    }
}

.mx_BazaarPage_adActions {
    display: flex;
    flex-direction: column;
    gap: 8px;

    button {
        min-width: 100px;
    }
}

.mx_BazaarPage_buyFlow {
    display: grid;
    gap: 14px;
}

.mx_BazaarPage_step {
    border: 1px solid var(--bz-line);
    border-radius: 14px;
    padding: 14px;
    background: var(--bz-panel);

    p {
        margin: 6px 0;
        color: var(--bz-text);
    }
}

.mx_BazaarPage_step--actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 12px;
}

.mx_BazaarPage_stepTitle {
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--bz-text);
}

.mx_BazaarPage_paymentPlaceholder {
    width: 100%;
    height: 200px;
    border-radius: 12px;
    margin: 12px 0;
    background:
        linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(67, 160, 71, 0.1)),
        repeating-linear-gradient(
            45deg,
            var(--bz-subtle-bg),
            var(--bz-subtle-bg) 10px,
            var(--bz-line) 10px,
            var(--bz-line) 20px
        );
}

.mx_BazaarPage_myAds,
.mx_BazaarPage_myPurchases {
    display: grid;
    gap: 10px;
}

.mx_BazaarPage_myAd {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--bz-line);
    border-radius: 14px;
    padding: 12px 14px;
    background: var(--bz-panel);
    flex-wrap: wrap;

    strong {
        color: var(--bz-text);
    }

    small {
        color: var(--bz-muted);
    }
}

.mx_BazaarPage_adRowActions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.mx_BazaarPage_tabButtons {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
    flex-wrap: wrap;

    .mx_BazaarPage_btn.active {
        background: var(--bz-green);
        color: var(--cpd-color-text-on-solid-primary);
        border-color: transparent;
    }
}

.mx_BazaarPage_empty {
    color: var(--bz-muted);
    padding: 14px;
}

.mx_BazaarPage_badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
}

.mx_BazaarPage_badge--sold {
    background: rgba(220, 38, 38, 0.15);
    color: var(--bz-red);
}

.mx_BazaarPage_badge--active {
    background: rgba(67, 160, 71, 0.18);
    color: var(--bz-green2);
}

.mx_BazaarPage_previousAds {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--bz-line);
}

.mx_BazaarPage_previousAds h3 {
    margin-bottom: 16px;
    color: var(--bz-text);
}

.mx_BazaarPage_editPanel {
    margin-top: 24px;
    padding: 24px;
    border-radius: 14px;
    border: 1px solid var(--bz-line);
    background: var(--bz-subtle-bg);
    width: 100%;
}

.mx_BazaarPage_editPanel h3 {
    margin: 0 0 20px;
    color: var(--bz-text);
}

.mx_BazaarPage_editGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
}

.mx_BazaarPage_editField {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.mx_BazaarPage_editField label {
    font-size: 13px;
    font-weight: 600;
    color: var(--bz-muted);
}

.mx_BazaarPage_editField input {
    height: 42px;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid var(--bz-input-border);
    background: var(--bz-input-bg);
    color: var(--bz-text);
}

.mx_BazaarPage_editActions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
}

@media (max-width: 1100px) {
    .mx_BazaarPage {
        flex-direction: column;
    }

    .mx_BazaarPage_sidebar {
        width: 100%;
        position: relative;
        top: auto;
        max-height: none;
    }

    .mx_BazaarPage_filters {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 720px) {
    .mx_BazaarPage_grid {
        grid-template-columns: 1fr;
    }

    .mx_BazaarPage_adCard {
        grid-template-columns: 1fr;

        img {
            width: 100%;
            height: auto;
        }
    }

    .mx_BazaarPage_adActions {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .mx_BazaarPage_filters {
        grid-template-columns: 1fr;
    }
}
