.mx_HomePage {
    max-width: 960px;
    width: 100%;
    height: 100%;
    margin-left: auto;
    margin-right: auto;
}

.mx_HomePage_default {
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;

    .mx_HomePage_default_wrapper {
        margin-block: 20px;
    }

    img {
        height: 48px;
    }

    h1 {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-32px;
        line-height: 1.375;
        margin-bottom: 4px;
    }

    h2 {
        margin-top: 4px;
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-18px;
        line-height: $font-25px;
        color: $muted-fg-color;
    }

    .mx_MiniAvatarUploader {
        margin: 0 auto;
    }

    .mx_HomePage_default_buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin: 60px auto 0;
        width: fit-content;

        .mx_AccessibleButton {
            padding: 73px 8px 15px; /* top: 20px top padding + 40px icon + 13px margin */

            width: 160px;
            min-height: 132px;
            margin: 20px;
            position: relative;
            display: inline-block;
            border-radius: 8px;
            vertical-align: top;
            word-break: break-word;
            box-sizing: border-box;

            font-weight: var(--cpd-font-weight-semibold);
            font-size: $font-15px;
            line-height: $font-20px;
            color: #fff; /* on all themes */
            background-color: $accent;

            &::before {
                top: 20px;
                left: 60px; /* (160px-40px)/2 */
                width: 40px;
                height: 40px;

                content: "";
                position: absolute;
                background-color: #fff; /* on all themes */
                mask-repeat: no-repeat;
                mask-size: contain;
            }

            &.mx_HomePage_button_sendDm::before {
                mask-image: url("$(res)/img/element-icons/feedback.svg");
            }

            &.mx_HomePage_button_explore::before {
                mask-image: url("$(res)/img/element-icons/roomlist/explore.svg");
            }

            &.mx_HomePage_button_createGroup::before {
                mask-image: url("$(res)/img/element-icons/group-members.svg");
            }
        }
    }
}

/* Mobile responsive layout */
@media only screen and (max-width: 768px) {
    .mx_HomePage_default {
        .mx_HomePage_default_buttons {
            flex-direction: column;
            align-items: center;

            .mx_AccessibleButton {
                width: 80%;
                max-width: 280px;
                margin: 8px auto;
            }
        }

        h1 {
            font-size: 24px;
        }

        h2 {
            font-size: 16px;
        }
    }
}

@media only screen and (max-width: 480px) {
    .mx_HomePage {
        max-width: 100%;
        padding: 0 8px;
        box-sizing: border-box;
    }

    .mx_HomePage_default {
        .mx_HomePage_default_wrapper {
            padding: 0 4px;
            width: 100%;
            box-sizing: border-box;
        }

        .mx_HomePage_default_buttons {
            margin-top: 24px;
            width: 100%;

            .mx_AccessibleButton {
                width: 100%;
                max-width: 100%;
                min-height: 80px;
                padding: 48px 8px 10px;
                margin: 6px 0;
                font-size: 13px;

                &::before {
                    left: calc(50% - 16px);
                    width: 32px;
                    height: 32px;
                    top: 12px;
                }
            }
        }

        h1 {
            font-size: 20px;
        }

        h2 {
            font-size: 14px;
        }

        img {
            height: 36px;
        }
    }
}
