.mx_HomePage {
    max-width: 960px;
    width: 100%;
    height: 100%;
    margin-left: auto;
    margin-right: auto;
    --home-primary: #0dbd8b;
    --home-primary-hover: #0aa378;
    --home-border-radius: 12px;
    --home-shadow: 0 4px 12px rgba(0, 0, 0, 0.05);
    --home-transition: all 0.3s ease;
}

.mx_HomePage_default {
    text-align: center;
    display: flex;

    .mx_HomePage_default_wrapper {
        margin-top: 40px;
        width: 100%;
    }

    img {
        height: 48px;
    }

    h1 {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-32px;
        line-height: 1.375;
        margin-bottom: 8px;
        color: var(--cpd-color-text-primary);
    }

    h2 {
        margin-top: 4px;
        font-weight: 400;
        font-size: $font-18px;
        line-height: $font-25px;
        color: var(--cpd-color-text-secondary);
    }

    .mx_MiniAvatarUploader {
        margin: 0 auto 20px;
    }

    .mx_HomePage_default_buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin: 60px auto 0;
        width: fit-content;
        padding-bottom: 30px;
    }

    .mx_AccessibleButton {
        border-radius: var(--home-border-radius);
        border: 1px solid var(--cpd-color-text-secondary) !important;
        box-shadow: var(--home-shadow);
        width: 200px;
        min-height: 180px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        cursor: pointer;
        transition: var(--home-transition);
        border: 1px solid transparent;
        position: relative;
        overflow: hidden;
        text-decoration: none;

        &:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            border-color: rgba(13, 189, 139, 0.3);
        }

        &:active {
            transform: translateY(-2px);
        }

        .mx_IconBox {
            width: 56px;
            height: 56px;
            background-color: rgba(13, 189, 139, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            transition: var(--home-transition);

            svg {
                width: 28px;
                height: 28px;
                fill: var(--home-primary);
                transition: var(--home-transition);
            }
        }

        &:hover .mx_IconBox {
            background-color: var(--home-primary);

            svg {
                fill: #fff;
            }
        }

        .mx_TextWrapper {
            display: flex;
            flex-direction: column;
        }

        .mx_CardText {
            font-weight: 600;
            font-size: $font-15px;
            line-height: $font-20px;
            color: var(--cpd-color-text-primary);
        }

        .mx_CardSubtext {
            font-size: 0.8rem;
            color: var(--cpd-color-text-secondary);
            margin-top: 4px;
        }
    }
}

/* Mobile responsive layout */
@media only screen and (max-width: 768px) {
    .mx_HomePage_default {
        .mx_HomePage_default_buttons {
            gap: 16px;
        }

        .mx_AccessibleButton {
            width: 160px;
            min-height: 150px;
            padding: 16px;
        }

        h1 {
            font-size: 24px;
        }

        h2 {
            font-size: 16px;
        }
    }
}

@media only screen and (max-width: 480px) {
    .mx_HomePage {
        max-width: 100%;
        padding: 0 16px;
        box-sizing: border-box;
    }

    .mx_HomePage_default {
        justify-content: flex-start;
        padding-top: 40px;

        .mx_HomePage_default_wrapper {
            padding: 0;
            width: 100%;
            box-sizing: border-box;
        }

        .mx_HomePage_default_buttons {
            margin-top: 24px;
            width: 100%;
            flex-direction: column;
            align-items: stretch;

            .mx_AccessibleButton {
                width: 100%;
                max-width: 100%;
                min-height: 80px;
                padding: 16px;
                margin: 6px 0;
                flex-direction: row;
                justify-content: flex-start;
                text-align: right;

                .mx_IconBox {
                    width: 48px;
                    height: 48px;
                    margin-bottom: 0;
                    margin-left: 16px;
                    flex-shrink: 0;
                }

                .mx_TextWrapper {
                    justify-content: center;
                }
            }
        }

        h1 {
            font-size: 20px;
        }

        h2 {
            font-size: 14px;
        }

        img {
            height: 36px;
        }
    }
}
